{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValuationInputPacket",
  "type": "object",
  "required": ["company", "ticker", "currency", "model_inputs"],
  "properties": {
    "company": {"type": "string"},
    "ticker": {"type": "string"},
    "currency": {"type": "string"},
    "analysis_as_of": {"type": "string"},
    "market_data_as_of": {"type": "string"},
    "latest_financial_period": {"type": "string"},
    "model_inputs": {
      "type": "object",
      "description": "Model-keyed input blocks. Values may be raw or bound objects with value/data_ids/assumption_ids."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {"type": "string"},
          "value": {},
          "unit": {"type": "string"},
          "data_ids": {"type": "array", "items": {"type": "string"}},
          "assumption_ids": {"type": "array", "items": {"type": "string"}},
          "required": {"type": "boolean"}
        }
      }
    },
    "structured_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption", "value", "scenario", "evidence", "confidence", "sensitivity"],
        "properties": {
          "assumption": {"type": "string"},
          "value": {},
          "unit": {"type": "string"},
          "scenario": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "sensitivity": {"type": "string", "enum": ["high", "medium", "low"]},
          "source_or_reason": {"type": "string"}
        }
      }
    },
    "data_points": {
      "type": "array",
      "items": {"$ref": "data_point.schema.json"}
    }
  }
}
