{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvestmentReportOutput",
  "type": "object",
  "required": [
    "target_overview",
    "company_classification",
    "master_lens_used",
    "pyramid_summary",
    "mind_map_summary",
    "data_freshness_check",
    "data_provenance",
    "valuation_model_selection",
    "execution_gate_checklist",
    "final_view"
  ],
  "properties": {
    "output_language": {
      "type": "string",
      "enum": [
        "auto",
        "en",
        "zh-CN"
      ]
    },
    "target_overview": {
      "type": "object"
    },
    "data_freshness_check": {
      "type": "object"
    },
    "data_provenance": {
      "type": "object",
      "properties": {
        "data_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "blocked"
          ]
        },
        "analysis_as_of": {
          "type": "string"
        },
        "market_data_as_of": {
          "type": "string"
        },
        "latest_financial_period": {
          "type": "string"
        },
        "missing_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_data_sources_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_user_provided_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "why_it_helps",
              "how_to_provide"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "why_it_helps": {
                "type": "string"
              },
              "how_to_provide": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "valuation_model_selection": {
      "type": "object",
      "properties": {
        "base_type": {
          "type": "string"
        },
        "primary_model": {
          "type": "string"
        },
        "cross_check_model": {
          "type": "string"
        },
        "downside_model": {
          "type": "string"
        },
        "implied_expectation_model": {
          "type": "string"
        },
        "overlay_models": {
          "type": "object",
          "properties": {
            "dividend_models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "technology_models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cyclicality_models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cloud_models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "specialist_models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "blocked_models": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "blocked"
          ]
        },
        "support_level": {
          "type": "string"
        },
        "active_route_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deferred_routes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "token_mode": {
          "type": "string"
        },
        "token_control": {
          "type": "object"
        },
        "company_type_route": {
          "type": "string"
        },
        "primary_workflow": {
          "type": "string"
        },
        "auxiliary_workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "core_quality_gate": {
          "type": "object"
        }
      }
    },
    "valuation_results": {
      "type": "object",
      "properties": {
        "primary_model": {
          "type": "string"
        },
        "bear_value": {},
        "base_value": {},
        "bull_value": {},
        "current_price": {},
        "margin_of_safety": {},
        "key_assumptions": {
          "type": "array"
        },
        "conclusion_change_triggers": {
          "type": "array",
          "description": "High-sensitivity assumption changes that would change the rating, margin-of-safety judgment, or action zones.",
          "items": {
            "type": "object",
            "required": [
              "assumption",
              "change",
              "impact"
            ],
            "properties": {
              "assumption": {
                "type": "string"
              },
              "change": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              }
            }
          }
        },
        "structured_assumptions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "assumption_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "blocked"
          ]
        },
        "sensitivity_summary": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "usable",
            "blocked",
            "low_confidence",
            "historical_only"
          ]
        },
        "calculation_detail": {
          "type": "object",
          "description": "Optional. Include only for explicit audit/debug/appendix/formula/workbook requests; never required for default user-facing output. Default reports must not include step-by-step valuation calculation traces, internal routing scorecards, formula derivations, discounting schedules, or derived metric tables."
        },
        "company_type": {
          "type": "string"
        },
        "dividend_shareholder_return_summary": {
          "type": "object",
          "properties": {
            "dividend_safety": {
              "type": "string",
              "enum": [
                "safe",
                "watch",
                "unsafe",
                "blocked",
                "not_applicable"
              ]
            },
            "shareholder_yield_judgment": {
              "type": "string"
            },
            "dividend_yield_band_judgment": {
              "type": "string"
            },
            "ddm_relevance": {
              "type": "string",
              "enum": [
                "primary_support",
                "cross_check_only",
                "blocked",
                "not_applicable"
              ]
            }
          }
        },
        "technology_optionality_summary": {
          "type": "object",
          "properties": {
            "evidence_level": {
              "type": "string",
              "enum": [
                "monetized",
                "emerging",
                "efficiency_only",
                "narrative_only",
                "not_applicable",
                "blocked"
              ]
            },
            "valuation_treatment": {
              "type": "string",
              "enum": [
                "sotp",
                "scenario_optionality",
                "core_model_assumption",
                "no_separate_premium",
                "not_applicable",
                "blocked"
              ]
            },
            "evidence_quality": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low",
                "blocked"
              ]
            },
            "investment_implication": {
              "type": "string"
            }
          }
        },
        "intrinsic_value_range": {
          "type": "object",
          "description": "User-facing reasonable valuation range. Required for normal stock/company analysis unless blocked.",
          "properties": {
            "bear_value": {},
            "base_value": {},
            "bull_value": {},
            "range_status": {
              "type": "string",
              "enum": [
                "usable",
                "blocked",
                "low_confidence",
                "historical_only"
              ]
            }
          }
        },
        "valuation_status": {
          "type": "string",
          "enum": [
            "undervalued",
            "fair",
            "expensive",
            "blocked",
            "low_confidence",
            "historical_only"
          ]
        },
        "blocked_or_low_confidence_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk_analysis": {
      "type": "object"
    },
    "moat_assessment": {
      "type": "object",
      "description": "Compact user-facing moat assessment. Use blocked, low_confidence, or not_applicable when data or comparability is insufficient.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "usable",
            "blocked",
            "low_confidence",
            "not_applicable"
          ]
        },
        "roic": {},
        "wacc": {},
        "roic_spread": {},
        "inferred_moat_rating": {
          "type": "string",
          "enum": [
            "wide",
            "narrow",
            "weak_or_none",
            "blocked"
          ]
        },
        "rating_label": {
          "type": "string"
        },
        "moat_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "moat_trend": {
          "type": "string",
          "enum": [
            "widening",
            "stable",
            "narrowing",
            "blocked"
          ]
        },
        "five_forces_resilience_score": {},
        "required_margin_of_safety": {},
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "blocked"
          ]
        },
        "evidence_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_or_low_confidence_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "peer_comparison": {
      "type": "object",
      "description": "Compact peer and relative valuation assessment. Use blocked, low_confidence, or not_applicable when no credible peer set exists.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "usable",
            "blocked",
            "low_confidence",
            "not_applicable"
          ]
        },
        "benchmark_company": {
          "type": "string"
        },
        "peer_selection_logic": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "moat_gap_vs_benchmark": {},
        "relative_valuation_verdict": {
          "type": "string",
          "enum": [
            "cheap",
            "reasonable",
            "expensive",
            "blocked",
            "low_confidence"
          ]
        },
        "valuation_premium_discount": {},
        "is_discount_premium_justified": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "mixed",
            "blocked"
          ]
        },
        "comparison_metric_used": {
          "type": "string"
        },
        "summary_rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "blocked"
          ]
        },
        "blocked_or_low_confidence_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "investor_action_framework": {
      "type": "object",
      "required": [
        "price_zones",
        "price_zone_assumption_basis",
        "position_aware_suggestions",
        "tranche_plan",
        "key_conditions"
      ],
      "properties": {
        "price_zones": {
          "type": "array",
          "description": "Required price/action zones. Use blocked placeholders if valuation range is unavailable.",
          "items": {
            "type": "object",
            "required": [
              "zone",
              "price_range",
              "interpretation"
            ],
            "properties": {
              "zone": {
                "type": "string",
                "enum": [
                  "Deep Value",
                  "Accumulation",
                  "Watchlist",
                  "Fair Value",
                  "Trim",
                  "Sell / Avoid"
                ]
              },
              "price_range": {
                "type": "string"
              },
              "interpretation": {
                "type": "string"
              }
            }
          }
        },
        "price_zone_assumption_basis": {
          "type": "array",
          "description": "Plain-language explanation of the valuation anchors, margin-of-safety thresholds, and assumptions used to derive price zones.",
          "items": {
            "type": "string"
          }
        },
        "position_aware_suggestions": {
          "type": "array",
          "description": "Required conditional guidance by investor position type.",
          "items": {
            "type": "object",
            "required": [
              "investor_type",
              "suggested_action",
              "rationale"
            ],
            "properties": {
              "investor_type": {
                "type": "string",
                "enum": [
                  "Empty Position",
                  "Half Position",
                  "Full Position",
                  "Overweight Position"
                ]
              },
              "suggested_action": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        "tranche_plan": {
          "type": "object",
          "required": [
            "starter_range",
            "add_range",
            "strong_add_range",
            "hold_range",
            "trim_range",
            "exit_review_range"
          ],
          "properties": {
            "starter_range": {
              "type": "string"
            },
            "add_range": {
              "type": "string"
            },
            "strong_add_range": {
              "type": "string"
            },
            "hold_range": {
              "type": "string"
            },
            "trim_range": {
              "type": "string"
            },
            "exit_review_range": {
              "type": "string"
            }
          }
        },
        "key_conditions": {
          "type": "object",
          "required": [
            "add_only_if",
            "hold_only_if",
            "trim_if",
            "exit_or_avoid_if"
          ],
          "properties": {
            "add_only_if": {
              "type": "string"
            },
            "hold_only_if": {
              "type": "string"
            },
            "trim_if": {
              "type": "string"
            },
            "exit_or_avoid_if": {
              "type": "string"
            }
          }
        },
        "framework_status": {
          "type": "string",
          "enum": [
            "usable",
            "blocked",
            "low_confidence"
          ]
        }
      }
    },
    "execution_gate_checklist": {
      "type": "array"
    },
    "final_view": {
      "type": "object"
    },
    "mind_map_summary": {
      "type": "object"
    },
    "pyramid_summary": {
      "type": "object",
      "properties": {
        "executive_conclusion": {
          "type": "object"
        },
        "decision_snapshot": {
          "type": "array"
        },
        "core_thesis": {
          "type": "array"
        },
        "valuation_summary": {
          "type": "object",
          "description": "User-facing valuation range, company type, selected model stack, dividend/shareholder-return judgment, technology optionality treatment, margin of safety, key assumptions, and sensitivity summary only. No step-by-step calculation trace."
        },
        "action_framework": {
          "type": "object"
        },
        "company_classification": {
          "type": "object",
          "description": "User-facing company classification, overlays, evidence quality, and implications only. No internal routing scorecard."
        }
      }
    },
    "company_classification": {
      "type": "object",
      "required": [
        "base_type",
        "overlays",
        "classification_confidence"
      ],
      "properties": {
        "base_type": {
          "type": "string"
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classification_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "blocked"
          ]
        },
        "classification_interpretation": {
          "type": "string"
        },
        "blocked_or_low_confidence_overlays": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "description": "Company classification result based on economic profile and overlays. Do not include internal score-by-score routing unless explicitly requested."
    },
    "master_lens_used": {
      "type": "array",
      "description": "Master/framework lenses used in the user-facing analysis, with rationale and impact.",
      "items": {
        "type": "object",
        "required": [
          "master",
          "rationale",
          "influence"
        ],
        "properties": {
          "master": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "influence": {
            "type": "string"
          }
        }
      }
    },
    "downgraded_master_lenses": {
      "type": "array",
      "description": "Master/framework lenses considered but downgraded or deferred.",
      "items": {
        "type": "object"
      }
    },
    "token_efficiency": {
      "type": "object",
      "properties": {
        "selected_route": {
          "type": "string"
        },
        "activated_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deferred_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calculation_trace_visible": {
          "type": "boolean"
        },
        "internal_scorecard_visible": {
          "type": "boolean"
        }
      }
    },
    "output_contract": {
      "type": "object",
      "properties": {
        "renderer": {
          "type": "string"
        },
        "validator": {
          "type": "string"
        },
        "calculation_trace_visible": {
          "type": "boolean"
        },
        "fixed_sections_required": {
          "type": "boolean"
        }
      }
    }
  }
}
